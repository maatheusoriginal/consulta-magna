# ---------------------------------------------------------------------------
# Atendimento: número do consultor no WhatsApp.
# Formato internacional, apenas dígitos (55 + DDD + número).
# Número oficial: +55 34 99196-0908
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMERO=5534991960908

# ---------------------------------------------------------------------------
# Tabela FIPE — APIs públicas e gratuitas, sem chave.
# Fonte primária: Parallelum. A BrasilAPI é contingência APENAS para marcas e
# modelos; anos e valor FIPE dependem só da Parallelum.
# Só preencha para apontar para outro espelho.
# ---------------------------------------------------------------------------
# FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# ---------------------------------------------------------------------------
# Persistência de leads — OBRIGATÓRIA EM PRODUÇÃO.
# Sem esta variável a aplicação usa o ConsoleLeadRepository, que apenas registra
# um resumo no log do servidor e NÃO persiste o lead.
#
# Em produção, sem ela a rota POST /api/lead responde 503 e o fluxo não avança
# até o WhatsApp — não existe "lead salvo" que na verdade não foi salvo.
# O build e o startup também emitem aviso explícito.
# Em desenvolvimento o ConsoleLeadRepository continua funcionando.
# ---------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://hook.exemplo.com/leads

# ---------------------------------------------------------------------------
# Precificação (ver docs/PRECIFICACAO.md).
# Todos os valores abaixo são configuração comercial e devem ser confirmados
# pela Magna antes de ir a produção.
# ---------------------------------------------------------------------------
# Piso mínimo contratual da participação, em reais (padrão 1800).
# NEXT_PUBLIC_PARTICIPACAO_MINIMA=1800
#
# Piso da taxa de adesão, em reais (padrão 300). A adesão cobrada é
# max(piso, mensalidade da modalidade escolhida).
# NEXT_PUBLIC_TAXA_ADESAO_MINIMA=300
#
# Oculta modalidades de participação economicamente dominadas pelo piso mínimo.
# Padrão false: por padrão exibimos todas as modalidades.
# NEXT_PUBLIC_HIDE_DOMINATED_PARTICIPATION_OPTIONS=false
#
# Agravo da mensalidade para uso comercial (aplicativo/táxi).
# Padrão 1.1666667, inferido da cotação comercial do Prisma LTZ 1.4 2015.
# Uso comercial NUNCA altera o plano recomendado.
# NEXT_PUBLIC_FATOR_USO_COMERCIAL=1.1666667
#
# Modalidades de participação indisponíveis para uso comercial (lista separada
# por vírgula: padrao, reduzida, minima, zero).
# Padrão: reduzida,minima,zero — carro de aplicativo/táxi só tem a Padrão.
# NEXT_PUBLIC_PARTICIPACOES_BLOQUEADAS_USO_COMERCIAL=reduzida,minima,zero

# ---------------------------------------------------------------------------
# Consulta por placa (OPCIONAL).
# Não existe API pública gratuita de placa. Verificamos a documentação da
# Invertexto (https://api.invertexto.com/, setembro de 2026): ela NÃO oferece
# consulta de placa, então a integração específica foi removida.
#
# Resta o provider genérico: aponte para o serviço que você contratar usando
# {placa} como marcador.
#
# Sem estas variáveis a consulta por placa não é simulada: a interface avisa e
# encaminha para a busca por marca/modelo/ano, que funciona 100% apenas com a
# API gratuita da FIPE.
#
# PLACA_API_URL=https://api.exemplo.com/veiculo/{placa}
# PLACA_API_AUTH_HEADER=Authorization
# PLACA_API_AUTH_VALUE=Bearer seu_token
#
# O provider deve devolver marca, modelo e ano. Se devolver também a categoria
# (tipo/tipoVeiculo/categoria/especie), ela é normalizada para carros, motos ou
# caminhoes. Sem categoria a interface pergunta ao cliente antes de buscar na
# FIPE — uma moto nunca é procurada na tabela de carros.
# ---------------------------------------------------------------------------
