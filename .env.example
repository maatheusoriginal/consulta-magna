# ---------------------------------------------------------------------------
# Obrigatório para o atendimento: número do consultor no WhatsApp.
# Formato internacional, apenas dígitos (55 + DDD + número).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMERO=5511999999999

# ---------------------------------------------------------------------------
# Tabela FIPE — APIs públicas e gratuitas, sem chave.
# A aplicação usa a Parallelum FIPE API e cai automaticamente para a BrasilAPI
# se ela estiver fora do ar. Só preencha para apontar para outro espelho.
# ---------------------------------------------------------------------------
# FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# ---------------------------------------------------------------------------
# Consulta por placa (OPCIONAL).
# Não existe API pública gratuita de placa. Sem nenhuma das variáveis abaixo, a
# consulta por placa encaminha o usuário para a busca por marca/modelo/ano, que
# funciona 100% apenas com a API gratuita da FIPE.
#
# Opção A — Invertexto (possui plano gratuito com token):
# PLACA_API_TOKEN=seu_token
#
# Opção B — qualquer outro provedor; use {placa} como marcador:
# PLACA_API_URL=https://api.exemplo.com/veiculo/{placa}
# PLACA_API_AUTH_HEADER=Authorization
# PLACA_API_AUTH_VALUE=Bearer seu_token
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Envio dos leads (OPCIONAL). Sem isso os leads só vão para o log do servidor.
# ---------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://hook.make.com/xxxxxxxx
